# ============================================================
# StockFlow — Firebase Environment Configuration
# ============================================================
# Copy this file to .env and fill in your Firebase project values.
# Get these from: https://console.firebase.google.com
#   → Select your project → Project Settings → General → Your apps
# ============================================================

VITE_FIREBASE_API_KEY=AIzaSyCZ2UO25f...
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=100000000000
VITE_FIREBASE_APP_ID=1:100000000000:web:...
VITE_FIREBASE_MEASUREMENT_ID=G-...

# ============================================================
# DEMO EVALUATION MODE (Disabled by Default):
# Set to 'true' ONLY if you want to run offline without a real
# Firebase cloud project (uses browser localStorage).
# ============================================================
VITE_ENABLE_DEMO_MODE=false
